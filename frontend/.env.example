# Base URL the app uses to call the FastAPI backend.
# Keep /api/v1 in development (Vite proxies it). In production, point it at the deployed API,
# e.g. https://api.example.com/api/v1, and add the site's origin to WEDDING_CORS_ORIGINS on the backend.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
