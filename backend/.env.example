# Copy to .env and adjust. All variables use the WEDDING_ prefix.

# Database connection URL.
#   Local:    sqlite:///./data/wedding.db  (default when unset)
#   Supabase: the "Transaction pooler" URL (port 6543) from Connect in the dashboard, e.g.
#             postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
WEDDING_DATABASE_URL=sqlite:///./data/wedding.db

# Create tables automatically on startup. Set to false on Supabase and run
# migrations/001_create_rsvps.sql instead (it also locks down the Supabase Data API).
WEDDING_AUTO_CREATE_SCHEMA=true

# JSON file with the event details shown on the card.
WEDDING_EVENT_FILE=./data/event.json

# Comma-separated origins allowed to call the API (where the Vue app is hosted).
WEDDING_CORS_ORIGINS=http://localhost:5173

# Optional regex for extra allowed origins, e.g. Vercel preview deployments:
# WEDDING_CORS_ORIGIN_REGEX=https://wedding-frontend-[a-z0-9-]+\.vercel\.app

# Secret for the admin endpoint (GET /api/v1/admin/rsvps). Leave empty to disable it.
WEDDING_ADMIN_API_KEY=
